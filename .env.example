# These values belong in your API host's environment settings, never in Android.
PORT=8080
# On Google Cloud use an assigned service account (Application Default Credentials).
# On other hosts paste the complete service-account JSON on one line into this variable.
FIREBASE_SERVICE_ACCOUNT=
# Set your real OpenAI key only in the hosting dashboard or your local .env file.
OPENAI_API_KEY=
OPENAI_QUIZ_MODEL=gpt-4o
