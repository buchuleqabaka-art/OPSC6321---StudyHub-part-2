<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/lilac_background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:id="@+id/group_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="24sp" android:textColor="@color/ink" android:textStyle="bold" />
<TextView android:id="@+id/group_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:padding="12dp" />
<TextView android:id="@+id/group_code" android:layout_width="match_parent" android:layout_height="wrap_content" android:textIsSelectable="true" android:textColor="@color/ink_muted" android:padding="12dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/group_tasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/planning_tasks" />
<com.google.android.material.button.MaterialButton android:id="@+id/group_sessions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/planning_sessions" />
<com.google.android.material.button.MaterialButton android:id="@+id/group_chat" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/group_chat" />
<com.google.android.material.button.MaterialButton android:id="@+id/group_back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/back" />
</LinearLayout></ScrollView>
