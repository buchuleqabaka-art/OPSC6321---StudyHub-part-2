<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="7dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="@color/lilac_surface"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <CheckBox android:id="@+id/task_completed" android:layout_width="wrap_content" android:layout_height="48dp" android:buttonTint="@color/lilac_primary_dark" />
            <TextView android:id="@+id/task_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/ink" android:textSize="16sp" android:textStyle="bold" />
            <com.google.android.material.button.MaterialButton android:id="@+id/task_delete" style="@style/Widget.Material3.Button.TextButton" android:layout_width="48dp" android:layout_height="48dp" android:minWidth="48dp" android:text="×" android:textColor="#FFB3261E" android:textSize="22sp" />
        </LinearLayout>
        <TextView android:id="@+id/task_due" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:textColor="@color/ink_muted" android:textSize="13sp" />
        <TextView android:id="@+id/task_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="48dp" android:layout_marginTop="4dp" android:textColor="@color/ink_muted" android:textSize="13sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
