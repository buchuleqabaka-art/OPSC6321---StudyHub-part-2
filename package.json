{
  "name": "studyhub-api",
  "version": "1.0.0",
  "description": "REST API for the StudyHub Android app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-studyhub \"node --test tests/firestore/*.test.cjs\"",
    "test:quiz": "node --test tests/quiz/*.test.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "3.0.4",
    "firebase": "10.14.1",
    "firebase-tools": "13.35.1"
  }
}
