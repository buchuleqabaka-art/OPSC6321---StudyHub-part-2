rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsProfile(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isGroupMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function validMembershipChange() {
      let before = resource.data.memberIds;
      let after = request.resource.data.memberIds;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && before is list
        && after is list
        && (
          (request.auth.uid in after
            && !(request.auth.uid in before)
            && after.size() == before.size() + 1
            && after.hasAll(before))
          ||
          (request.auth.uid in before
            && !(request.auth.uid in after)
            && before.size() == after.size() + 1
            && before.hasAll(after))
        );
    }

    match /users/{userId} {
      allow read: if ownsProfile(userId);
      allow create: if ownsProfile(userId)
        && request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'dateOfBirth', 'course', 'yearOfStudy',
          'photoUrl', 'points', 'tasksCompleted', 'provider', 'createdAt'
        ])
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow update: if ownsProfile(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'dateOfBirth', 'course', 'yearOfStudy', 'photoUrl'
        ]);
      allow delete: if false;

      // Device tokens are only written by the trusted REST API using Admin SDK.
      match /deviceTokens/{tokenId} {
        allow read, write: if false;
      }
    }

    match /emailIndex/{emailHash} {
      // The document contains only { registered: true }; only point lookups are allowed.
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['registered'])
        && request.resource.data.registered == true;
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      // A signed-in user may fetch a known group ID to join it, but cannot list all groups.
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100;
      allow update: if signedIn() && validMembershipChange();
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isGroupMember(groupId);
        allow create, update: if isGroupMember(groupId) && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80;
        allow delete: if signedIn() && request.auth.uid == memberId;
      }

      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId)
          && request.resource.data.keys().hasOnly([
            'id', 'groupId', 'senderId', 'senderName', 'text', 'sentAt'
          ])
          && request.resource.data.groupId == groupId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() <= 80
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.sentAt is int;
        allow update, delete: if false;
      }
    }

    function canReadPlanning(data) {
      return signedIn() && (data.ownerId == request.auth.uid
        || (data.get('groupId', '') != '' && isGroupMember(data.groupId)));
    }

    function validTask(data) {
      return data.keys().hasOnly(['id', 'title', 'description', 'dueDate', 'assignedToId',
          'assignedToName', 'groupId', 'priority', 'completed', 'ownerId'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 4000
        && data.dueDate is int && data.dueDate > 0
        && data.assignedToId is string && data.assignedToName is string
        && data.assignedToName.size() <= 200
        && data.groupId is string
        && data.priority in ['HIGH', 'MEDIUM', 'LOW'] && data.completed is bool;
    }

    match /tasks/{taskId} {
      allow read: if canReadPlanning(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && validTask(request.resource.data)
        && request.resource.data.completed == false
        && request.resource.data.dueDate > request.time.toMillis()
        && (request.resource.data.groupId == ''
          ? request.resource.data.assignedToId == request.auth.uid
          : isGroupMember(request.resource.data.groupId)
            && request.resource.data.assignedToId in get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.memberIds);
      // Completion is a field update: never replace another member's ownership or assignment.
      allow update: if canReadPlanning(resource.data)
        && (resource.data.ownerId == request.auth.uid || resource.data.assignedToId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed'])
        && request.resource.data.completed is bool;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function validSession(data) {
      return data.keys().hasOnly(['id', 'title', 'description', 'groupId', 'startTime',
          'endTime', 'location', 'attendeeIds', 'ownerId'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.description is string && data.description.size() <= 4000
        && data.location is string && data.location.size() <= 300
        && data.groupId is string
        && data.startTime is int && data.endTime is int && data.endTime > data.startTime;
    }

    match /sessions/{sessionId} {
      allow read: if canReadPlanning(resource.data);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && validSession(request.resource.data)
        && request.resource.data.startTime > request.time.toMillis()
        && (request.resource.data.groupId == '' || isGroupMember(request.resource.data.groupId))
        && request.resource.data.attendeeIds is list
        && request.resource.data.attendeeIds == [request.auth.uid];
      allow update: if canReadPlanning(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendeeIds'])
        && request.resource.data.attendeeIds is list
        && (
          (request.auth.uid in request.resource.data.attendeeIds
            && !(request.auth.uid in resource.data.attendeeIds)
            && request.resource.data.attendeeIds.size() == resource.data.attendeeIds.size() + 1
            && request.resource.data.attendeeIds.hasAll(resource.data.attendeeIds))
          ||
          (request.auth.uid in resource.data.attendeeIds
            && !(request.auth.uid in request.resource.data.attendeeIds)
            && resource.data.attendeeIds.size() == request.resource.data.attendeeIds.size() + 1
            && resource.data.attendeeIds.hasAll(request.resource.data.attendeeIds))
        );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /quotes/{quoteId} {
      allow read: if true;
      allow write: if false;
    }

    match /resources/{resourceId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
